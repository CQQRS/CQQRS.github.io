{
  "name": "cqqrs-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "env:dev": "cp ./environment/dev.ts ./environment/environment.ts",
	"env:prod": "cp ./environment/prod.ts ./environment/environment.ts",
	"docusaurus": "docusaurus",
    "start": "npm run env:dev && docusaurus start",
    "build": "npm run env:prod && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "npm run env:prod && docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "npm run env:prod && docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
